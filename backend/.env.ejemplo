# Copiar este archivo a ".env" y completar con valores propios antes de correr el sistema.
# NUNCA subir el archivo ".env" real a un repositorio publico.

# Puerto donde escucha la API
PUERTO=4000

# Entorno de ejecucion: desarrollo | produccion
NODE_ENV=desarrollo

# Clave secreta para firmar los tokens de sesion (JWT).
# Debe ser una cadena larga, aleatoria y unica por instalacion.
# Se puede generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=cambiar_esta_clave_por_una_generada_aleatoriamente

# Duracion de la sesion (formato aceptado por la libreria jsonwebtoken)
JWT_DURACION=8h

# Origen permitido para peticiones del frontend (CORS)
ORIGEN_PERMITIDO=http://localhost:5173

# Credenciales del administrador inicial (usadas solo por el script de siembra)
ADMIN_EMAIL_INICIAL=admin@sistema.local
ADMIN_PASSWORD_INICIAL=CambiarInmediatamente123!
